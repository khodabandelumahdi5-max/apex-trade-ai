# --- Mode -------------------------------------------------------------
# paper | live
TRADING_MODE=paper
# required for live
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_REAL_FUNDS_AT_RISK
INITIAL_CAPITAL_USD=10000
LOOP_INTERVAL_SEC=60
# SYMBOL:MINT[:CEX_SYMBOL], comma-separated
WATCHLIST=SOL:So11111111111111111111111111111111111111112:SOL/USDT:USDT,JUP:JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN

# --- Infrastructure ---------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./apex.db
# TimescaleDB auto-detected
# DATABASE_URL=postgresql+asyncpg://apex:secret@localhost:5432/apex
# strongly recommended: public RPC refuses whale discovery
HELIUS_API_KEY=
ENABLE_WS_STREAM=false
JUPITER_API_BASE=https://lite-api.jup.ag
JUPITER_API_KEY=
USE_JITO=true
JITO_TIP_LAMPORTS=10000
# base58, live DEX only. Use a dedicated low-balance wallet.
SOLANA_PRIVATE_KEY=

# --- MEXC spot ----------------------------------------------------------
# jupiter | mexc   (mexc: prices, candles, order book and fills all come from MEXC)
EXECUTION_VENUE=jupiter
# Live MEXC only. Create the key with SPOT TRADING permission ONLY (never withdrawal), bind it to your IP.
MEXC_API_KEY=
MEXC_API_SECRET=
# Hard cap: in live mode INITIAL_CAPITAL_USD (the bot's budget) must be <= this
MAX_LIVE_CAPITAL_USD=100

# --- CEX futures (optional) -------------------------------------------
# binance | bybit
CEX_EXCHANGE=
CEX_API_KEY=
CEX_API_SECRET=
CEX_TESTNET=true
CEX_LEVERAGE=1

# --- On-chain ---------------------------------------------------------
# extra wallets to track, comma-separated
WHALE_WALLETS=
# strict: needs ACCUMULATION | veto: blocks only on DISTRIBUTION
ONCHAIN_MODE=strict
ONCHAIN_FLOW_THRESHOLD_PCT=0.5

# --- Risk -------------------------------------------------------------
# hard ceiling 2.0
MAX_RISK_PER_TRADE_PCT=1.0
KELLY_FRACTION=0.25
MAX_POSITION_PCT=25
MAX_OPEN_POSITIONS=3
MAX_PORTFOLIO_VAR_PCT=3
DAILY_LOSS_LIMIT_PCT=3
MAX_DRAWDOWN_PCT=10
BREAKEVEN_TRIGGER_PCT=1.5
# >0 covers fees so a breakeven exit is not a small loss
BREAKEVEN_BUFFER_PCT=0.0
TRAILING_STOP_PCT=2.0
MAX_SLIPPAGE_BPS=50
MAX_PRICE_IMPACT_PCT=1.0
