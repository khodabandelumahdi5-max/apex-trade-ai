# --- Mode -------------------------------------------------------------
TRADING_MODE=paper                 # paper | live
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_REAL_FUNDS_AT_RISK   # required for live
INITIAL_CAPITAL_USD=10000
LOOP_INTERVAL_SEC=60
# SYMBOL:MINT[:CEX_SYMBOL], comma-separated
WATCHLIST=SOL:So11111111111111111111111111111111111111112:SOL/USDT:USDT,JUP:JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN

# --- Infrastructure ---------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./apex.db
# DATABASE_URL=postgresql+asyncpg://apex:secret@localhost:5432/apex    # TimescaleDB auto-detected
HELIUS_API_KEY=                    # strongly recommended: public RPC refuses whale discovery
ENABLE_WS_STREAM=false
JUPITER_API_BASE=https://lite-api.jup.ag
JUPITER_API_KEY=
USE_JITO=true
JITO_TIP_LAMPORTS=10000
SOLANA_PRIVATE_KEY=                # base58, live DEX only. Use a dedicated low-balance wallet.

# --- CEX futures (optional) -------------------------------------------
CEX_EXCHANGE=                      # binance | bybit
CEX_API_KEY=
CEX_API_SECRET=
CEX_TESTNET=true
CEX_LEVERAGE=1

# --- On-chain ---------------------------------------------------------
WHALE_WALLETS=                     # extra wallets to track, comma-separated
ONCHAIN_MODE=strict                # strict: needs ACCUMULATION | veto: blocks only on DISTRIBUTION
ONCHAIN_FLOW_THRESHOLD_PCT=0.5

# --- Risk -------------------------------------------------------------
MAX_RISK_PER_TRADE_PCT=1.0         # hard ceiling 2.0
KELLY_FRACTION=0.25
MAX_POSITION_PCT=25
MAX_OPEN_POSITIONS=3
MAX_PORTFOLIO_VAR_PCT=3
DAILY_LOSS_LIMIT_PCT=3
MAX_DRAWDOWN_PCT=10
BREAKEVEN_TRIGGER_PCT=1.5
BREAKEVEN_BUFFER_PCT=0.0           # >0 covers fees so a breakeven exit is not a small loss
TRAILING_STOP_PCT=2.0
MAX_SLIPPAGE_BPS=50
MAX_PRICE_IMPACT_PCT=1.0
